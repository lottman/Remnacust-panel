{
  "compilerOptions": {
    "target": "es2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./build/backend",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "noEmit": false,
    "lib": [
      "es2020"
    ],
    "declaration": true,
    "declarationMap": true,
    "types": [
      "node"
    ]
  },
  "exclude": [
    "scripts/**/*",
    "tests/**/*",
    "**/*.spec.ts",
    "**/*.test.ts",
    "build",
    "node_modules"
  ]
}
