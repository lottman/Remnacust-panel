{
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "es2020"
    ],
    "module": "NodeNext",
    "outDir": "./build/frontend",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ]
  },
  "exclude": [
    "build",
    "node_modules"
  ]
}
