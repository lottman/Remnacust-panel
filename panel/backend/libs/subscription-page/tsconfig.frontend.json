{
  "compilerOptions": {
    "target": "es2017",
    "module": "NodeNext",
    "outDir": "./build/frontend",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ]
  }
}
