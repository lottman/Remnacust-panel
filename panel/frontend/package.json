  "type": "module",
  "scripts": {
    "start:dev": "vite",
    "prestart:build": "node verify-editor-assets.mjs && node docs-tools/check-documentation.mjs",
    "start:build": "NODE_ENV=production tsc && vite build",
    "precb": "node verify-editor-assets.mjs && node docs-tools/check-documentation.mjs",
    "cb": "vite build",
    "start:preview": "vite preview --port 3333",
    "serve": "NODE_ENV=production tsc && vite build && vite preview --port 3333",
    "serve:dev": "tsc && vite build && vite preview --port 3333",
    "typecheck": "tsc --noEmit",
    "docs:generate": "node docs-tools/generate-guide.mjs && node docs-tools/generate-reference.mjs",
    "docs:check": "node docs-tools/check-documentation.mjs",
    "i18n:check": "node i18n-tools/check-locales.mjs && node i18n-tools/check-used-keys.mjs",
    "i18n:audit": "node i18n-tools/check-locales.mjs --audit && node i18n-tools/check-used-keys.mjs && node i18n-tools/audit-ui-strings.mjs",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/favicons/logo.svg",
    "toc": "i18next-resources-for-ts toc -i ./public/locales/en -o @types/resources.ts",
    "crowdin:download": "crowdin download translations --language=af --branch=dev",
    "crowdin:upload": "crowdin upload sources --branch=dev",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint --format=stylish",
    "lint:fix": "oxlint --fix",
    "check": "oxfmt --check && oxlint",
    "fix": "oxfmt && oxlint --fix"
  },
